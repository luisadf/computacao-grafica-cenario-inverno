{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Cenario de Inverno",
            "type": "process",
            "command": "gcc",
            "args": [
                "-std=c99",
                "-Wall",
                "-Wextra",
                "-O2",
                "${workspaceFolder}\\src\\main.c",
                "-o",
                "${workspaceFolder}\\cenario_inverno.exe",
                "-lfreeglut",
                "-lopengl32",
                "-lglu32",
                "-lm"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "detail": "Compila o projeto C usando o MinGW e o FreeGLUT instalados."
        }
    ]
}
